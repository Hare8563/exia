{
  "id": "S_000",
  "backgroundFile": "bg_01.webp",
  "characters": [
    {
      "index": 0,
      "name": "渚",
      "imageFile": "chara_01.webp",
      "isShow": true,
      "speakerId": 3
    },
    {
      "index": 1,
      "name": "凛",
      "imageFile": "chara_02.webp",
      "isShow": true,
      "speakerId": 2
    }
  ],
  "lines": [
    {
      "id": "start",
      "type": 0,
      "text": "ようこそ、Exiaノベルゲームエンジンへ！<br>このチュートリアルでは、基本機能を紹介します。"
    },
    {
      "type": 0,
      "text": "画面をクリックするか、スペースキーを押して、ストーリーを進めることができます。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "こんにちは！私が渚です。Exiaの機能を順に説明していきましょう。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "まず、この画面のようにキャラクターがセリフを話すことができます。<br>これは「ダイアログ」モードと呼ばれています。"
    },
    {
      "type": 0,
      "text": "これは「ナレーション」モードです。ストーリーの背景説明などに使用されます。"
    },
    {
      "character": { "index": 1 },
      "type": 1,
      "text": "私は凛です！複数のキャラクターが会話することもできますね。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "その通りです。次に特殊な表現方法を紹介します。"
    },
    {
      "character": { "index": 1 },
      "type": 1,
      "text": "テキストは<br>このように改行したり、<br><span style=\"font-size:24px\">サイズを変えたり</span>することもできます。"
    },
    {
      "cutIn": { "imageFile": "cut_01.webp" },
      "type": 0,
      "text": "これはカットインです。特定のシーンを強調するために使用できます。"
    },
    {
      "cutIn": { "imageFile": "cut_01.webp" },
      "character": { "index": 0 },
      "type": 1,
      "text": "カットインが表示されている状態でもキャラクターが会話できますね。"
    },
    {
      "type": 0,
      "text": "カットインを非表示にすることもできます。"
    },
    {
      "cutIn": { "imageFile": "cg_01.webp", "isFullScreen": true },
      "type": 0,
      "text": "これはフルスクリーンCGです。重要なシーンや背景の変更に使用できます。"
    },
    {
      "cutIn": { "imageFile": "cg_01.webp", "isFullScreen": true },
      "character": { "index": 1 },
      "type": 1,
      "text": "CGの上にキャラクターのセリフを表示することもできます。物語の臨場感が増しますね！"
    },
    {
      "character": { "index": 1 },
      "type": 0,
      "text": "CGを終了して、通常のシーンに戻ります。"
    },
    {
      "character": { "index": 0, "name": "渚", "imageFile": "chara_01.webp" },
      "type": 1,
      "text": "そして最後に、Exiaの重要な機能である「選択肢」を紹介します。<br>ユーザーは物語の進行を選ぶことができます。"
    },

    {
      "type": 2,
      "text": "どのような機能についてもっと知りたいですか？",
      "choices": [
        { "text": "テキストスタイルについて", "jumpTo": "./::set_feature_text" },
        { "text": "キャラクター表示について",  "jumpTo": "./::set_feature_chara" }
      ]
    },

    { "id": "set_feature_text",  "type": "flag", "set": { "first_choice": "text" } },
    { "type": "jump", "to": "./::text_style_choice" },

    { "id": "set_feature_chara", "type": "flag", "set": { "first_choice": "chara" } },
    { "type": "jump", "to": "./::character_choice" },

    {
      "id": "text_style_choice",
      "character": { "index": 0 },
      "type": 1,
      "text": "テキストスタイルについて説明します。Exiaでは、HTMLタグを使って<span style=\"color:red\">色</span>や<span style=\"font-weight:bold\">太字</span>などのスタイルを適用できます。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "また、テキストの表示速度も調整できます。これはゲームの雰囲気作りに重要な要素です。",
      "jumpTo": "./::choice_end"
    },

    {
      "id": "character_choice",
      "character": { "index": 1 },
      "type": 1,
      "text": "キャラクター表示について説明します。キャラクターの立ち絵は自由に切り替えることができます。"
    },
    {
      "character": { "index": 1, "imageFile": "chara_02.webp" },
      "type": 1,
      "text": "また、キャラクターの名前を途中で変更したり、表情を変えたりすることも可能です。ストーリーの展開に合わせて使い分けましょう。",
      "jumpTo": "./::choice_end"
    },

    {
      "id": "choice_end",
      "type": 2,
      "text": "もう一つ説明して欲しい機能はありますか？",
      "choices": [
        { "text": "選択肢の仕組みについて", "jumpTo": "./::set_want_mechanism" },
        { "text": "チュートリアルを終了する",  "jumpTo": "./::set_want_end" }
      ]
    },

    { "id": "set_want_mechanism", "type": "flag", "set": { "second_choice": "mechanism" } },
    { "type": "jump", "to": "./::want_branch" },

    { "id": "set_want_end", "type": "flag", "set": { "second_choice": "end" } },
    { "type": "jump", "to": "./::want_branch" },

    {
      "id": "want_branch",
      "character": { "index": 0 },
      "type": 1,
      "text": "わかりました！それでは...",
      "if": {
        "flag": "second_choice",
        "equals": "mechanism",
        "then": "./::choice_mechanism",
        "else": "./::tutorial_end"
      }
    },

    {
      "id": "choice_mechanism",
      "character": { "index": 0 },
      "type": 1,
      "text": "選択肢の仕組みについて説明します。各選択肢には「jumpTo」があり、選択後にジャンプする先のIDを指定します。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "フラグ（type: flag）でフラグをセットし、「if」プロパティで条件分岐できます。今体験していただいた機能がまさにそれです。"
    },
    {
      "character": { "index": 0 },
      "type": 1,
      "text": "さらに「type: jump」を使えば別のシナリオファイルへ移動できます。このチュートリアルの最後でも使いますよ！",
      "jumpTo": "./::tutorial_end"
    },

    {
      "id": "tutorial_end",
      "character": { "index": 0, "name": "渚", "imageFile": "chara_01.webp" },
      "type": 1,
      "text": "以上でExiaの基本機能紹介を終わります。実際にゲームを作る際は、これらの機能を組み合わせて豊かなストーリーテリングを実現してください。"
    },
    {
      "character": { "index": 1 },
      "type": 1,
      "text": "お疲れ様でした！ちなみに、最初に選んだのは..."
    },
    {
      "type": 0,
      "text": "（あなたの選択を振り返って）",
      "if": {
        "flag": "first_choice",
        "equals": "text",
        "then": "./::ending_text",
        "else": "./::ending_chara"
      }
    },

    {
      "id": "ending_text",
      "character": { "index": 0 },
      "type": 1,
      "text": "テキストスタイルでしたね。文章表現へのこだわりを感じます！",
      "jumpTo": "./::finale"
    },
    {
      "id": "ending_chara",
      "character": { "index": 1 },
      "type": 1,
      "text": "キャラクター表示でしたね。演出へのこだわりを感じます！",
      "jumpTo": "./::finale"
    },

    {
      "id": "finale",
      "type": 0,
      "text": "チュートリアル終了。メインに戻ります..."
    },
    { "type": "jump", "to": "main::entry" }
  ]
}
